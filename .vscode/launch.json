{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TaaS",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/TaaS/bin/Debug/net10.0/TaaS.dll",
      "args": [],
      "cwd": "${workspaceFolder}/TaaS",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7079;http://localhost:5079",
        // Valeurs par défaut en dev
        "User__Name": "root",
        "User__Password": "pass",
        "DataFolder": "data"
      }
    }
  ]
}
